/* ********************  Preprocessor Definitions  ******************** */

&Scoped-define PROCEDURE-TYPE SmartFrame
&Scoped-define DB-AWARE no

&Scoped-define ADM-CONTAINER FRAME

/* Name of designated FRAME-NAME and/or first browse and/or first query */
&Scoped-define FRAME-NAME F-Main

/* Standard List Definitions                                            */
&Scoped-Define ENABLED-OBJECTS BUTTON-8 BUTTON-9 BUTTON-10 BUTTON-12 ~
TOGGLE-rango FILL-IN-desde FILL-IN-hasta 
&Scoped-Define DISPLAYED-OBJECTS TOGGLE-rango FILL-IN-desde FILL-IN-hasta 

/* Custom List Definitions                                              */
/* List-1,List-2,List-3,List-4,List-5,List-6                            */

/* _UIB-PREPROCESSOR-BLOCK-END */
&ANALYZE-RESUME



/* ***********************  Control Definitions  ********************** */


/* Definitions of the field level widgets                               */
DEFINE BUTTON BUTTON-10 
     IMAGE-UP FILE "adeicon/rbuild%.ico":U
     LABEL "Ubica" 
     SIZE 7.72 BY 1.46
     FONT 3.

DEFINE BUTTON BUTTON-12 
     LABEL "Excel" 
     SIZE 7.72 BY 1.46
     FONT 3.

DEFINE BUTTON BUTTON-8 
     LABEL "ACTUALIZAR" 
     SIZE 15 BY 1.12.

DEFINE BUTTON BUTTON-9 
     IMAGE-UP FILE "img/printer.ico":U
     LABEL "Button 9" 
     SIZE 6 BY 1.62.

DEFINE VARIABLE FILL-IN-desde AS DATE FORMAT "99/99/9999":U 
     LABEL "Desde" 
     VIEW-AS FILL-IN 
     SIZE 11.86 BY .77
     FONT 3 NO-UNDO.

DEFINE VARIABLE FILL-IN-hasta AS DATE FORMAT "99/99/9999":U 
     LABEL "Hasta" 
     VIEW-AS FILL-IN 
     SIZE 12 BY .77
     FONT 3 NO-UNDO.

DEFINE VARIABLE TOGGLE-rango AS LOGICAL INITIAL no 
     LABEL "Historicos" 
     VIEW-AS TOGGLE-BOX
     SIZE 19 BY .77 NO-UNDO.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME F-Main
     BUTTON-8 AT ROW 1 COL 1 WIDGET-ID 2
     BUTTON-9 AT ROW 2.08 COL 1 WIDGET-ID 4
     BUTTON-10 AT ROW 2.12 COL 7.29 WIDGET-ID 6
     BUTTON-12 AT ROW 3.58 COL 7.29 WIDGET-ID 8
     TOGGLE-rango AT ROW 5.04 COL 2 WIDGET-ID 14
     FILL-IN-desde AT ROW 5.85 COL 6.72 COLON-ALIGNED WIDGET-ID 10
     FILL-IN-hasta AT ROW 6.62 COL 6.57 COLON-ALIGNED WIDGET-ID 12
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1 SCROLLABLE 
         FONT 3 WIDGET-ID 100.


/* *********************** Procedure Settings ************************ */

