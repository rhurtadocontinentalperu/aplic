ADD TABLE "AC-DMOV"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Detalle de Movimiento"
  DESCRIPTION "Detalle de Movientos de Activo Fijo"
  DUMP-NAME "ac-dmov"

ADD FIELD "Codcia" OF "AC-DMOV" AS integer 
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  HELP "Ingrese el Codigo del Compania"
  ORDER 10

ADD FIELD "Periodo" OF "AC-DMOV" AS integer 
  FORMAT "->>>9"
  INITIAL "0"
  LABEL "Periodo Contable"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Periodo"
  HELP "Ingrese el Periodo Contable"
  ORDER 20

ADD FIELD "Nromes" OF "AC-DMOV" AS integer 
  FORMAT "99"
  INITIAL "0"
  LABEL "Mes Contable"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Mes"
  HELP "Ingrese el Mes Contable"
  ORDER 30

ADD FIELD "CodMov" OF "AC-DMOV" AS character 
  DESCRIPTION "Código de Movimiento"
  FORMAT "X(4)"
  INITIAL ""
  LABEL "Código"
  POSITION 5
  MAX-WIDTH 8
  COLUMN-LABEL "Código"
  HELP "Ingrese el código de movimiento"
  ORDER 40

ADD FIELD "NroDoc" OF "AC-DMOV" AS character 
  FORMAT "X(10)"
  INITIAL ""
  LABEL "Número"
