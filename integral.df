ADD TABLE "CcbCDocu"
  AREA "Cobranzas"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  DESCRIPTION "Cabecera de documentos cuentas por cobrar"
  DUMP-NAME "ccbcdocu"
  TABLE-TRIGGER "REPLICATION-DELETE" NO-OVERRIDE PROCEDURE "APLIC\rpl\d-ccbcdocu.p" CRC "?" 
  TABLE-TRIGGER "REPLICATION-WRITE" NO-OVERRIDE PROCEDURE "aplic/rpl/w-ccbcdocu.p" CRC "?" 
  TABLE-TRIGGER "WRITE" NO-OVERRIDE PROCEDURE "aplic/triggers/w-ccbcdocu.p" CRC "?" 

