ADD TABLE "FELogComprobantes"
  AREA "Ventas"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Log Comprobantes FACT ELECTR"
  DESCRIPTION "Log de comprobantes para la facturación electrónica (FE)"
  DUMP-NAME "felogcomprobantes"
  TABLE-TRIGGER "REPLICATION-DELETE" NO-OVERRIDE PROCEDURE "aplic\Rpl\d-felogcomprobantes.p" CRC "?" 
  TABLE-TRIGGER "REPLICATION-WRITE" NO-OVERRIDE PROCEDURE "aplic\Rpl\w-felogcomprobantes.p" CRC "?" 

ADD FIELD "CodCia" OF "FELogComprobantes" AS integer 
  DESCRIPTION "Código de compañia"
  FORMAT "999"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  HELP "Código de compañia"
  ORDER 10

ADD FIELD "CodDoc" OF "FELogComprobantes" AS character 
  DESCRIPTION "Codigo del documento"
  FORMAT "x(3)"
  INITIAL ""
  LABEL "Codigo"
  POSITION 3
  MAX-WIDTH 6
  COLUMN-LABEL "Codigo"
  ORDER 30

