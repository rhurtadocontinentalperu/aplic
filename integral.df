ADD TABLE "CcbCfgCbd"
  AREA "Cobranzas"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Tabla Contable CtaCobrar"
  DESCRIPTION "Tabal de coniguración contable de las cuentas por cobrar"
  DUMP-NAME "ccbcfgctb"

ADD FIELD "CodCia" OF "CcbCfgCbd" AS integer 
  DESCRIPTION "Código de compañia"
  FORMAT "999"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  HELP "Código de compañia"
  ORDER 10

ADD FIELD "Tabla" OF "CcbCfgCbd" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 3
