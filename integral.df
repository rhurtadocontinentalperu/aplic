  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  DUMP-NAME "shut_user"

ADD FIELD "shut_status" OF "shut_user" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 2
  MAX-WIDTH 1
  ORDER 10

ADD FIELD "shut_id" OF "shut_user" AS integer 
  FORMAT "->>,>>>,>>9"
  INITIAL "0"
  POSITION 3
  MAX-WIDTH 4
  ORDER 20

