ADD FIELD "Codcia" OF "ImDCstP" AS integer 
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
