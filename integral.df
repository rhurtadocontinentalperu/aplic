ADD TABLE "Empresas"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Empresas"
  DESCRIPTION "Empresas Instaladas "
  DUMP-NAME "empresas"

ADD FIELD "CodCia" OF "Empresas" AS integer 
  DESCRIPTION "C¢digo de la Empresa "
  FORMAT "999"
  INITIAL "0"
  LABEL "C¢digo"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "C¢digo"
  VALEXP "CodCia > 0"
  VALMSG "Invalido Registro"
  HELP "C¢digo de la Empresa"
  ORDER 10

ADD FIELD "NomCia" OF "Empresas" AS character 
  DESCRIPTION "Nombre o Raz¢n Social de la Empresa "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Descripci¢n"
  POSITION 3
  MAX-WIDTH 80
  COLUMN-LABEL "Descripci¢n"
  HELP "Nombre/Raz¢n Social de la Empresa"
  ORDER 20

ADD FIELD "Direccion" OF "Empresas" AS character 
  DESCRIPTION "Direcci¢n"
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Direcci¢n"
  POSITION 4
  MAX-WIDTH 80
  COLUMN-LABEL "Direcci¢n"
  HELP "Direcci¢n de la Empresa"
  ORDER 30

ADD FIELD "Telefonos" OF "Empresas" AS character 
  DESCRIPTION "Tel‚fonos"
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Tel‚fonos"
  POSITION 5
  MAX-WIDTH 60
  COLUMN-LABEL "Tel‚fonos"
  HELP "Tel‚fonos de la Empresa"
  ORDER 40

ADD FIELD "RUC" OF "Empresas" AS character 
  DESCRIPTION "Nro. RUC"
  FORMAT "x(8)"
  INITIAL ""
  LABEL "RUC"
  POSITION 6
  MAX-WIDTH 16
  COLUMN-LABEL "RUC"
  HELP "Nro. del Registro Unico del Contribuyente"
  ORDER 50

ADD FIELD "Campo-CodCli" OF "Empresas" AS logical 
  DESCRIPTION "Yes Significa que los clientes son genericos (CodCia = 0) No  Significa que los clientes son propios                "
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Archivo de Clientes Unificado"
  POSITION 7
  MAX-WIDTH 1
  COLUMN-LABEL "Cli!Uni"
  HELP "Yes Unificado, No Propio"
  ORDER 60

ADD FIELD "Campo-CodPro" OF "Empresas" AS logical 
  DESCRIPTION "Yes significa que los proveedores son genericos (CodCia=0) No  significa que los proveedores son propios"
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Archivo de Proveedores Unificado"
  POSITION 8
  MAX-WIDTH 1
  COLUMN-LABEL "Pro!Uni"
  HELP "Yes unificado, No propio"
  ORDER 70

ADD FIELD "Campo-Clinica" OF "Empresas" AS logical 
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Archivo de Cl¡nicas Unificado"
  POSITION 9
  MAX-WIDTH 1
  COLUMN-LABEL "Cl¡nica!Uni"
  HELP "Yes Unificado, No Propio"
  ORDER 110

ADD FIELD "Campo-CodCbd" OF "Empresas" AS logical 
  DESCRIPTION "Yes siginifica que las cuentas son genericas (CodCia = 0) No  siginifica que las cuentas son propias"
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Archivos Contables Unificado"
  POSITION 10
  MAX-WIDTH 1
  COLUMN-LABEL "Cbd!Uni"
  HELP "Yes unificado, No propio"
  ORDER 100

