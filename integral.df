ADD TABLE "articulo"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  DUMP-NAME "articulo"

ADD FIELD "CodCia" OF "articulo" AS integer 
  DESCRIPTION "Código de compañia"
  FORMAT "999"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  HELP "Código de compañia"
  ORDER 10

ADD FIELD "DesMat" OF "articulo" AS character 
  DESCRIPTION "Descripción del material"
  FORMAT "X(45)"
  INITIAL ""
  LABEL "Descripción"
  POSITION 3
  MAX-WIDTH 90
  COLUMN-LABEL "Descripción"
  HELP "Descripción del material"
  ORDER 30

ADD FIELD "UndStk" OF "articulo" AS character 
  DESCRIPTION "Unidad de stock"
  FORMAT "X(4)"
  INITIAL ""
  LABEL "Unidad de stock"
  POSITION 4
  MAX-WIDTH 8
  COLUMN-LABEL "Unidad!stock"
  HELP "Unidad de stock"
  ORDER 50

ADD FIELD "MonVta" OF "articulo" AS integer 
  DESCRIPTION "Moneda de venta"
  FORMAT "9"
  INITIAL "0"
  LABEL "Moneda"
  POSITION 5
  MAX-WIDTH 4
  VIEW-AS "VIEW-AS RADIO-SET    RADIO-BUTTONS ""Soles"" , 1 , ""Dolares"" , 2    VERTICAL    "
  COLUMN-LABEL "Moneda!venta"
  HELP "Moneda de venta"
  ORDER 100

ADD FIELD "CodMar" OF "articulo" AS character 
  FORMAT "X(8)"
  INITIAL ""
  LABEL "marca"
  POSITION 6
  MAX-WIDTH 16
  ORDER 230

ADD FIELD "desmar" OF "articulo" AS character 
  FORMAT "X(30)"
  INITIAL ""
  LABEL "Des.Marca"
  POSITION 7
  MAX-WIDTH 60
  COLUMN-LABEL "Des.Marca"
  ORDER 240

ADD FIELD "codfam" OF "articulo" AS character 
  DESCRIPTION "Código de familia"
  FORMAT "X(2)"
  INITIAL ""
  LABEL "Familia"
  POSITION 8
  MAX-WIDTH 4
  COLUMN-LABEL "Código!familia"
  HELP "Código de familia"
  ORDER 140

ADD FIELD "FchAct" OF "articulo" AS date 
  DESCRIPTION "Fecha de actualización"
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Fecha"
  POSITION 9
  MAX-WIDTH 4
  COLUMN-LABEL "Fecha"
  HELP "Fecha de actualización"
  ORDER 150

ADD FIELD "FchUSal" OF "articulo" AS date 
  DESCRIPTION "Fecha de ultima salida"
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Ultima salida"
  POSITION 10
  MAX-WIDTH 4
  COLUMN-LABEL "Ultima!salida"
  HELP "Fecha de ultima salida"
  ORDER 160

ADD FIELD "FchUCmp" OF "articulo" AS date 
  DESCRIPTION "Fecha de ultima compra"
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Ultima compra"
  POSITION 11
  MAX-WIDTH 4
  COLUMN-LABEL "Ultima!compra"
  HELP "Fecha de ultima compra"
  ORDER 170

ADD FIELD "subfam" OF "articulo" AS character 
  FORMAT "X(3)"
  INITIAL ""
  LABEL "Sub-Familia"
  POSITION 12
  MAX-WIDTH 6
  COLUMN-LABEL "Sub!Familia"
  ORDER 180

ADD FIELD "CodAnt" OF "articulo" AS character 
  FORMAT "X(8)"
  INITIAL ""
  LABEL "Codigo Anterior"
  POSITION 13
  MAX-WIDTH 16
  COLUMN-LABEL "Codigo!Anterior"
  ORDER 190

ADD FIELD "Detalle" OF "articulo" AS character 
  FORMAT "X(256)"
  INITIAL ""
  LABEL "Detalle"
  POSITION 14
  MAX-WIDTH 512
  COLUMN-LABEL "Detalle"
  ORDER 200

ADD FIELD "codmat" OF "articulo" AS character 
  FORMAT "X(6)"
  INITIAL ""
  LABEL "Codigo Articulo"
  POSITION 15
  MAX-WIDTH 12
  COLUMN-LABEL "Codigo Articulo"
  ORDER 220

ADD INDEX "IDX01" ON "articulo" 
  AREA "Miscelaneos"
  PRIMARY
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "codmat" ASCENDING 

