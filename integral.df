ADD TABLE "VtaCProm"
  AREA "Ventas"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Promociones - cabecera"
  DESCRIPTION "Promociones por división"
  DUMP-NAME "vtacprom"
  TABLE-TRIGGER "REPLICATION-DELETE" NO-OVERRIDE PROCEDURE "APLIC\rpl\d-vtacprom.p" CRC "?" 
  TABLE-TRIGGER "REPLICATION-WRITE" NO-OVERRIDE PROCEDURE "APLIC\rpl\w-vtacprom.p" CRC "?" 

ADD FIELD "CodCia" OF "VtaCProm" AS integer 
  DESCRIPTION "Codigo de la Empresa "
  FORMAT "999"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  VALEXP "CodCia >= 0"
  VALMSG "Invalido Registro"
  HELP "Codigo de la Empresa"
  ORDER 10

ADD FIELD "CodDoc" OF "VtaCProm" AS character 
  FORMAT "X(3)"
  INITIAL ""
  LABEL "Documento"
  POSITION 3
  MAX-WIDTH 6
  COLUMN-LABEL "Doc."
  ORDER 30

ADD FIELD "NroDoc" OF "VtaCProm" AS integer 
  FORMAT ">>>>>9"
  INITIAL "0"
  LABEL "Numero"
  POSITION 4
  MAX-WIDTH 4
  ORDER 40

ADD FIELD "CodPro" OF "VtaCProm" AS character 
  DESCRIPTION "Codigo del Proveedor"
  FORMAT "x(11)"
  INITIAL ""
  LABEL "Codigo"
  POSITION 5
  MAX-WIDTH 22
  COLUMN-LABEL "Codigo"
  HELP "C¢digo del Proveedor"
  ORDER 50

ADD FIELD "CodMon" OF "VtaCProm" AS integer 
  DESCRIPTION "1: Soles  2: Dolares"
  FORMAT "9"
  INITIAL "1"
  LABEL "Moneda"
  POSITION 6
  MAX-WIDTH 4
  ORDER 60

ADD FIELD "Glosa" OF "VtaCProm" AS character 
  FORMAT "x(50)"
  INITIAL ""
  LABEL "Observaciones"
  POSITION 7
  MAX-WIDTH 100
  ORDER 70

ADD FIELD "Importe" OF "VtaCProm" AS decimal 
  FORMAT "->>,>>9.9999"
  INITIAL "0"
  LABEL "Importe"
  POSITION 8
  MAX-WIDTH 17
  DECIMALS 4
  ORDER 80

ADD FIELD "FlgEst" OF "VtaCProm" AS character 
  DESCRIPTION "A: activo  I: inactivo"
  FORMAT "x"
  INITIAL "A"
  POSITION 9
  MAX-WIDTH 2
  ORDER 90

ADD FIELD "CodDiv" OF "VtaCProm" AS character 
  FORMAT "x(5)"
  INITIAL "00000"
  LABEL "División"
  POSITION 10
  MAX-WIDTH 10
  COLUMN-LABEL ""
  ORDER 20

ADD FIELD "TipProm" OF "VtaCProm" AS integer 
  DESCRIPTION "Tipo de promocion:
1: por importe    2: por cantidad"
  FORMAT "->,>>>,>>9"
  INITIAL "1"
  POSITION 11
  MAX-WIDTH 4
  ORDER 100

ADD FIELD "Cantidad" OF "VtaCProm" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 12
  MAX-WIDTH 4
  ORDER 110

ADD FIELD "Desde" OF "VtaCProm" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 13
  MAX-WIDTH 4
  ORDER 120

ADD FIELD "Hasta" OF "VtaCProm" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 14
  MAX-WIDTH 4
  ORDER 130

