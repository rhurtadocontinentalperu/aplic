ADD TABLE "Menus"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Menus de los Sistemas"
  DUMP-NAME "menus"

ADD FIELD "Modulo" OF "Menus" AS character 
  DESCRIPTION "Codigo del Paquete Instalado"
  FORMAT "!(3)"
  INITIAL ""
  LABEL "Modulo"
  POSITION 2
  MAX-WIDTH 6
  COLUMN-LABEL "Modulo"
  VALEXP "TRIM(Modulo) <> """""
  VALMSG "Invalido Registro"
  HELP "Codigo del Paquete Instalado"
  ORDER 10

ADD FIELD "CodMnu" OF "Menus" AS character 
  FORMAT "X(6)"
  INITIAL ""
  LABEL "Opcion del Menu"
  POSITION 3
  MAX-WIDTH 12
  COLUMN-LABEL "Opcion"
  VALEXP "LENGTH(TRIM(CodMnu)) = 2 OR LENGTH(TRIM(CodMnu)) = 4 OR LENGTH(TRIM(CodMnu)) = 6"
  VALMSG "Debe tener 2,4,6 digitos el codigo"
  HELP "Codigo de la opcion del menu"
  ORDER 20
  MANDATORY

ADD FIELD "Etiqueta" OF "Menus" AS character 
  FORMAT "X(30)"
  INITIAL ""
  LABEL "Etiqueta"
  POSITION 4
  MAX-WIDTH 60
  COLUMN-LABEL "Etiqueta"
  HELP "Etiqueta de la opcion del menu"
  ORDER 30

ADD FIELD "Tipo" OF "Menus" AS character 
  FORMAT "!"
  INITIAL ""
  LABEL "Tipo"
  POSITION 5
  MAX-WIDTH 2
  COLUMN-LABEL "Tipo"
  VALEXP "LOOKUP( Tipo, ""P,S,R"" ) <> 0"
  VALMSG "Invalido Registro, Solo debera contener ""R"" o ""S"" o ""P"""
  HELP "Tipo de Opcion de Menu ( P->Programa S->Sub-Menu R->Raya)"
  ORDER 40

ADD FIELD "Programa" OF "Menus" AS character 
  FORMAT "X(30)"
  INITIAL ""
  LABEL "Programa"
  POSITION 6
  MAX-WIDTH 60
  COLUMN-LABEL "Programa"
  HELP "Programa a Ejecutar"
  ORDER 50

ADD FIELD "Grupos" OF "Menus" AS character 
  FORMAT "X(20)"
  INITIAL ""
  LABEL "Grupos"
  POSITION 7
  MAX-WIDTH 40
  COLUMN-LABEL "Grupos"
  HELP "Grupos autorizados a ejecutar las opciones"
  ORDER 60

ADD INDEX "MENU01" ON "Menus" 
  AREA "Miscelaneos"
  UNIQUE
  PRIMARY
  INDEX-FIELD "Modulo" ASCENDING 
  INDEX-FIELD "CodMnu" ASCENDING 

