  FORMAT "x(100)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 200
  ORDER 30

ADD FIELD "CostAccountingMethod" OF "oStdItems" AS character 
  DESCRIPTION "M todo de costeo:
bis_MovingAverage : M todo basado en el c lculo del coste medio del art culo en cada operaci n de compras y ventas. (Usar este valor)

bis_Standard : Sistema de determinaci n de precios que permite seleccionar un precio fijo que se utiliza despu s para todas las operaciones.

bis_FIFO : Sistema de inventario permanente donde el primer art culo adquirido tambi n es el primero que se vende, con independencia del flujo de mercanc as real."
  FORMAT "x(20)"
  INITIAL "bis_MovingAverage"
  POSITION 5
  MAX-WIDTH 40
  ORDER 40

ADD FIELD "DefaultWarehouse" OF "oStdItems" AS character 
  DESCRIPTION "Almac n por defecto"
  FORMAT "x(8)"
  INITIAL ""
  POSITION 6
  MAX-WIDTH 16
  ORDER 50

ADD FIELD "ForceSelectionOfSerialNumber" OF "oStdItems" AS character 
  DESCRIPTION "Selecci n forzosa de #Serie de Art.: tYES o tNO
"
  FORMAT "x(5)"
  INITIAL "tNO"
  POSITION 7
  MAX-WIDTH 6
  ORDER 60

ADD FIELD "Frozen" OF "oStdItems" AS character 
  DESCRIPTION "Art culo bloqueado?"
  FORMAT "x(5)"
  INITIAL "tNO"
  POSITION 8
  MAX-WIDTH 6
  ORDER 70

ADD FIELD "GLMethod" OF "oStdItems" AS character 
  DESCRIPTION "glm_WH : Todas las cuentas de mayor son definidas a nivel de almacenes. (usar este valor)

glm_ItemClass : Todas las cuentas de mayor son definidas a nivel de grupo de art culos.

glm_ItemLevel : Cualquier cuenta de mayor es definida a nivel de art culo."
  FORMAT "x(15)"
  INITIAL "glm_ItemClass"
  POSITION 9
  MAX-WIDTH 30
  ORDER 80

