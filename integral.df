  FORMAT "x(25)"
  INITIAL ""
  POSITION 5
  MAX-WIDTH 50
  ORDER 40

ADD FIELD "server_usr" OF "shut_user" AS character 
  FORMAT "x(25)"
  INITIAL ""
  POSITION 6
  MAX-WIDTH 50
  ORDER 50

ADD FIELD "codcia" OF "shut_user" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "1"
  POSITION 7
  MAX-WIDTH 4
  ORDER 60

ADD FIELD "fcreacion" OF "shut_user" AS datetime 
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  INITIAL "now"
  POSITION 8
  MAX-WIDTH 8
  ORDER 70

ADD FIELD "id_log" OF "shut_user" AS int64 
  FORMAT "->>,>>>,>>9"
  INITIAL "0"
  POSITION 9
  MAX-WIDTH 8
  ORDER 80

ADD FIELD "fcha_shut" OF "shut_user" AS datetime 
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  INITIAL ?
  POSITION 10
  MAX-WIDTH 8
  ORDER 90

