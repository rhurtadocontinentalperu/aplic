  DESCRIPTION "Catalogo de material"
  DUMP-NAME "almmmatg"
  TABLE-TRIGGER "DELETE" NO-OVERRIDE PROCEDURE "Triggers\d-almmmatg.p" CRC "?" 
  TABLE-TRIGGER "REPLICATION-DELETE" NO-OVERRIDE PROCEDURE "APLIC\rpl\d-almmmatg.p" CRC "?" 
  TABLE-TRIGGER "REPLICATION-WRITE" NO-OVERRIDE PROCEDURE "APLIC\rpl\w-almmmatg.p" CRC "?" 
