ADD TABLE "OpenPrecios"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Precios para OpenOrange"
  DESCRIPTION "Precios para OpenOrange"
  DUMP-NAME "openprecios"

ADD FIELD "CodCia" OF "OpenPrecios" AS integer 
  DESCRIPTION "Código de compañia"
  FORMAT "999"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  HELP "Código de compañia"
  ORDER 10

ADD FIELD "codmat" OF "OpenPrecios" AS character 
  FORMAT "X(6)"
  INITIAL ""
  LABEL "Codigo Articulo"
  POSITION 3
  MAX-WIDTH 12
  COLUMN-LABEL "Codigo Articulo"
  ORDER 20

ADD FIELD "LogDate" OF "OpenPrecios" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  POSITION 4
  MAX-WIDTH 4
  ORDER 30

ADD FIELD "LogTime" OF "OpenPrecios" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 5
  MAX-WIDTH 16
  ORDER 40

ADD FIELD "LogUser" OF "OpenPrecios" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 6
  MAX-WIDTH 16
  ORDER 50

ADD FIELD "FlagUsuario" OF "OpenPrecios" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 7
  MAX-WIDTH 16
  ORDER 60

ADD FIELD "FlagFechaHora" OF "OpenPrecios" AS datetime 
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  INITIAL ?
  POSITION 8
  MAX-WIDTH 8
  ORDER 70

ADD FIELD "FlagMigracion" OF "OpenPrecios" AS character 
  DESCRIPTION "N: no migrado S: si migrado"
  FORMAT "x"
  INITIAL "N"
  POSITION 9
  MAX-WIDTH 2
  ORDER 80

ADD FIELD "flagestado" OF "OpenPrecios" AS character 
  DESCRIPTION "I:Nuevo U:Modificacion D:Eliminado"
  FORMAT "x(1)"
  INITIAL ""
  POSITION 10
  MAX-WIDTH 2
  ORDER 90

ADD INDEX "Idx00" ON "OpenPrecios" 
  AREA "Miscelaneos"
  PRIMARY
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "FlagMigracion" ASCENDING 
  INDEX-FIELD "FlagFechaHora" ASCENDING 

ADD INDEX "Idx01" ON "OpenPrecios" 
  AREA "Miscelaneos"
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "codmat" ASCENDING 
  INDEX-FIELD "LogDate" ASCENDING 
  INDEX-FIELD "LogTime" ASCENDING 

ADD TABLE "OpenVentas"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Ventas OpenOrange"
  DUMP-NAME "openventas"

ADD FIELD "CodDoc" OF "OpenVentas" AS character 
  DESCRIPTION "Codigo del documento"
  FORMAT "x(3)"
