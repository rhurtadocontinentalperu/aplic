ADD TABLE "AS-AHOR"
  AREA "Planillas"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Asignación de horario"
  DESCRIPTION "Asignación de horario"
  DUMP-NAME "as-ahor"

ADD FIELD "CodCia" OF "AS-AHOR" AS integer 
  DESCRIPTION "Código de Compañia"
  FORMAT "999"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  HELP "Código de Compañia"
  ORDER 10

ADD FIELD "CodPer" OF "AS-AHOR" AS character 
  FORMAT "x(6)"
  INITIAL ""
  LABEL "Código"
  POSITION 3
  MAX-WIDTH 12
  COLUMN-LABEL "Código"
  HELP "Código de personal"
  ORDER 20

ADD FIELD "FchIni" OF "AS-AHOR" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "Fecha de inicio"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Fecha de!inicio"
  HELP "Fecha de inicio"
  ORDER 30

ADD FIELD "FchFin" OF "AS-AHOR" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "Fecha fin"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Fecha fin"
  HELP "Fecha final"
  ORDER 40

ADD FIELD "CodHor" OF "AS-AHOR" AS character 
  FORMAT "XXX"
  INITIAL ""
  LABEL "Código de horario"
  POSITION 6
  MAX-WIDTH 6
  COLUMN-LABEL "Cod!hor"
  HELP "Código de horario asignado"
  LENGTH 0
  ORDER 60

ADD FIELD "FlgEst" OF "AS-AHOR" AS character 
  FORMAT "x"
  INITIAL ""
  LABEL "Flag"
  POSITION 7
  MAX-WIDTH 2
  HELP "Flag"
  ORDER 80

ADD INDEX "AHOR01" ON "AS-AHOR" 
  AREA "Planillas"
  PRIMARY
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "CodPer" ASCENDING 

ADD TABLE "AS-CHOR"
  AREA "Planillas"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Cabecera de horario"
  DESCRIPTION "Cabecera de horario"
  DUMP-NAME "as-chor"

ADD FIELD "CodHor" OF "AS-CHOR" AS character 
  FORMAT "XXX"
  INITIAL ""
  LABEL "Código"
  POSITION 2
  MAX-WIDTH 6
  HELP "Código de horario"
  LENGTH 0
  ORDER 10

ADD FIELD "Descripcion" OF "AS-CHOR" AS character 
  FORMAT "X(30)"
  INITIAL ""
  LABEL "Descripción"
  POSITION 3
  MAX-WIDTH 60
  COLUMN-LABEL "Descripción"
  HELP "Descripción de horario"
  ORDER 20

ADD FIELD "Tolera" OF "AS-CHOR" AS character 
  FORMAT "x(5)"
  INITIAL ""
  LABEL "Tolerancia"
  POSITION 4
  MAX-WIDTH 10
  COLUMN-LABEL "Tole-!rancia"
  HELP "Tiempo de tolerancia para este horario"
  ORDER 30

ADD FIELD "TpoHor" OF "AS-CHOR" AS logical 
  DESCRIPTION "		"
  FORMAT "Diurno/Nocturno"
  INITIAL "Diurno"
  LABEL "Tipo"
  POSITION 5
  MAX-WIDTH 1
  COLUMN-LABEL "Tipo"
  HELP "Tipo de horario (Dia/Noche)"
  ORDER 40

ADD FIELD "AftFer" OF "AS-CHOR" AS logical 
  FORMAT "Si/No"
  INITIAL "No"
  LABEL "Afecta feriados?"
  POSITION 6
  MAX-WIDTH 1
  COLUMN-LABEL "Aft!fer"
  HELP "Considera feriados como dias laborables? (Si/No)"
  ORDER 50

ADD INDEX "llave01" ON "AS-CHOR" 
  AREA "Planillas"
  UNIQUE
  PRIMARY
  INDEX-FIELD "CodHor" ASCENDING 

