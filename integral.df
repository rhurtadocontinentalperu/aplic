ADD TABLE "Vtacomvige"
  AREA "Ventas"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Comision - vigencia"
  DUMP-NAME "vtacomvige"

ADD FIELD "Codcia" OF "Vtacomvige" AS integer 
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  HELP "Ingrese el Codigo del Compania"
  ORDER 10

ADD FIELD "CodComis" OF "Vtacomvige" AS character 
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Codigo"
  POSITION 3
  MAX-WIDTH 8
  ORDER 20

ADD FIELD "FchIni" OF "Vtacomvige" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 4
  MAX-WIDTH 4
  ORDER 30

ADD FIELD "FchFin" OF "Vtacomvige" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 5
  MAX-WIDTH 4
  ORDER 40

ADD FIELD "PorComis" OF "Vtacomvige" AS decimal 
  FORMAT "->>,>>9.9999"
  INITIAL "0"
  LABEL "% Comisión"
  POSITION 6
  MAX-WIDTH 19
  DECIMALS 4
  ORDER 50

ADD INDEX "Llave01" ON "Vtacomvige" 
  AREA "Ventas"
  PRIMARY
  INDEX-FIELD "Codcia" ASCENDING 
  INDEX-FIELD "CodComis" ASCENDING 

