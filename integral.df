  ORDER 50

ADD FIELD "Fchdoc" OF "ImCCst" AS date 
  DESCRIPTION "Fecha de Emision del pedido de importacion"
  FORMAT "99/99/9999"
  INITIAL "today"
  LABEL "Fecha Emision"
