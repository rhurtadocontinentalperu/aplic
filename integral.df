  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  DUMP-NAME "pr-liqd2"

ADD FIELD "CodCia" OF "PR-LIQD2" AS integer 
  FORMAT "999"
  INITIAL "0"
  LABEL "Compañia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cias"
  HELP "Código de Compañia"
