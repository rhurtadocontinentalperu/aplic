  POSITION 9
  MAX-WIDTH 1
  ORDER 160

ADD FIELD "FlgCic" OF "VtaCorDiv" AS logical 
  DESCRIPTION "SI: Cuando llega al ultimo numero vuelve a comenzar
NO: termina cuando llega al final"
  FORMAT "Si/No"
  INITIAL "Si"
  LABEL "Reinicia el ciclo?"
