ADD TABLE "AC-CMOV"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  DESCRIPTION "Cabecera de Movimientos de Activos Fijos"
  DUMP-NAME "ac-cmov"

ADD FIELD "CodDiv" OF "AC-CMOV" AS character 
  FORMAT "x(5)"
  INITIAL ""
  LABEL "Divisionaria"
  POSITION 2
  MAX-WIDTH 10
  COLUMN-LABEL "Div."
  HELP "Ingrese el Codigo de Divisionaria"
  ORDER 70

ADD FIELD "Codcia" OF "AC-CMOV" AS integer 
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Cia"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  HELP "Ingrese el Codigo del Compania"
  ORDER 10

ADD FIELD "Periodo" OF "AC-CMOV" AS integer 
  FORMAT "->>>9"
  INITIAL "0"
  LABEL "Periodo Contable"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Periodo"
  HELP "Ingrese el Periodo Contable"
  ORDER 20

ADD FIELD "Nromes" OF "AC-CMOV" AS integer 
  FORMAT "99"
  INITIAL "0"
  LABEL "Mes Contable"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Mes"
  HELP "Ingrese el Mes Contable"
  ORDER 30

ADD FIELD "Codope" OF "AC-CMOV" AS character 
  FORMAT "xxx"
  INITIAL ""
  LABEL "Operacion"
  POSITION 6
  MAX-WIDTH 6
  COLUMN-LABEL "Ope"
  HELP "Ingrese la Operacion Contable"
  ORDER 80

ADD FIELD "Codmon" OF "AC-CMOV" AS integer 
  FORMAT "9"
  INITIAL "0"
  LABEL "Moneda"
  POSITION 7
  MAX-WIDTH 4
  COLUMN-LABEL "Mon"
  HELP "Ingrese el codigo de Moneda"
  ORDER 110

ADD FIELD "Glosa" OF "AC-CMOV" AS character 
  FORMAT "X(60)"
  INITIAL ""
  LABEL "Glosa"
  POSITION 8
  MAX-WIDTH 120
  VIEW-AS "VIEW-AS EDITOR    INNER-CHARS 40 INNER-LINES 3"
  COLUMN-LABEL "Glosa"
  HELP "Ingrese las observaciones del Asiento"
  ORDER 120

ADD FIELD "Usuario" OF "AC-CMOV" AS character 
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Usuario autor"
  POSITION 9
  MAX-WIDTH 24
  COLUMN-LABEL "usuario"
  HELP "Autor de la ultima modificacion del asiento"
  LENGTH 0
  ORDER 140

ADD FIELD "Flgest" OF "AC-CMOV" AS character 
  FORMAT "x"
  INITIAL ""
  POSITION 10
  MAX-WIDTH 2
  ORDER 130

ADD FIELD "CodMov" OF "AC-CMOV" AS character 
  DESCRIPTION "Código de Movimiento"
  FORMAT "X(4)"
  INITIAL ""
  LABEL "Código"
  POSITION 11
  MAX-WIDTH 8
  COLUMN-LABEL "Código"
  HELP "Ingrese el código de movimiento"
  ORDER 40

ADD FIELD "NroDoc" OF "AC-CMOV" AS character 
  FORMAT "X(10)"
  INITIAL ""
  LABEL "Número"
  POSITION 12
  MAX-WIDTH 20
  COLUMN-LABEL "NroMov"
  ORDER 50

ADD FIELD "FchDoc" OF "AC-CMOV" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Fecha"
  POSITION 13
  MAX-WIDTH 4
  COLUMN-LABEL "Fecha"
  ORDER 60

ADD FIELD "CCosto" OF "AC-CMOV" AS character 
  FORMAT "X(8)"
  INITIAL ""
  LABEL "CCosto"
  POSITION 14
  MAX-WIDTH 16
  COLUMN-LABEL "CCosto"
  ORDER 90

ADD FIELD "CodPar" OF "AC-CMOV" AS character 
  DESCRIPTION "Partida"
  FORMAT "X(10)"
  INITIAL ""
  LABEL "Partida"
  POSITION 15
  MAX-WIDTH 20
  COLUMN-LABEL "Partida"
  HELP "Partida"
  ORDER 100

ADD INDEX "Llave01" ON "AC-CMOV" 
  AREA "Miscelaneos"
  UNIQUE
  PRIMARY
  DESCRIPTION "Llave01"
  INDEX-FIELD "Codcia" ASCENDING 
  INDEX-FIELD "Periodo" ASCENDING 
  INDEX-FIELD "Nromes" ASCENDING 
  INDEX-FIELD "CodMov" ASCENDING 
  INDEX-FIELD "NroDoc" ASCENDING 

ADD TABLE "AC-CNFG"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Configuraciones"
  DESCRIPTION "Configuraciones del modulo de Activo Fijo"
  DUMP-NAME "ac-cnfg"

ADD FIELD "CodCia" OF "AC-CNFG" AS integer 
  DESCRIPTION "Código de la Empresa "
  FORMAT "999"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  VALEXP "CodCia >= 0"
  VALMSG "Invalido Registro"
  HELP "Código de la Empresa"
  ORDER 10

ADD FIELD "TpoCfg" OF "AC-CNFG" AS character 
  FORMAT "X(2)"
  INITIAL ""
  LABEL ""
  POSITION 3
  MAX-WIDTH 4
  ORDER 20

ADD FIELD "CodCfg" OF "AC-CNFG" AS character 
  FORMAT "X(3)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 6
  ORDER 30

ADD FIELD "DesCfg" OF "AC-CNFG" AS character 
  FORMAT "X(60)"
  INITIAL ""
  POSITION 5
  MAX-WIDTH 120
  ORDER 40

ADD FIELD "CodOpe" OF "AC-CNFG" AS character 
  FORMAT "X(3)"
  INITIAL ""
  LABEL "CodOpe"
  POSITION 6
  MAX-WIDTH 16
  COLUMN-LABEL "CodOpe"
  EXTENT 2
  ORDER 50

ADD FIELD "CodCta" OF "AC-CNFG" AS character 
  FORMAT "X(8)"
  INITIAL ""
  POSITION 7
  MAX-WIDTH 90
  EXTENT 5
  ORDER 60

ADD FIELD "CodFam" OF "AC-CNFG" AS character 
  FORMAT "X(10)"
  INITIAL ""
  LABEL "CodFam"
  POSITION 8
  MAX-WIDTH 20
  COLUMN-LABEL "CodFam"
  ORDER 70

ADD FIELD "trg-Usuario" OF "AC-CNFG" AS character 
  FORMAT "X(11)"
  INITIAL ""
  LABEL "Usuario"
  POSITION 9
  MAX-WIDTH 22
  ORDER 1190

ADD FIELD "trg-FchAct" OF "AC-CNFG" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Ultima Actualización"
  POSITION 10
  MAX-WIDTH 4
  ORDER 1200

ADD FIELD "trg-HraAct" OF "AC-CNFG" AS character 
  FORMAT "X(8)"
  INITIAL ""
  LABEL "Hora Actualización"
  POSITION 11
  MAX-WIDTH 16
  ORDER 1210

ADD INDEX "Llave01" ON "AC-CNFG" 
  AREA "Miscelaneos"
  UNIQUE
  PRIMARY
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "TpoCfg" ASCENDING 
  INDEX-FIELD "CodCfg" ASCENDING 

ADD TABLE "ac-copar"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "correlativo de activos"
  DUMP-NAME "ac-copar"

ADD FIELD "Codcia" OF "ac-copar" AS integer 
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  HELP "Ingrese el Codigo del Compania"
  ORDER 10

ADD FIELD "codcta" OF "ac-copar" AS character 
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Cuenta Contable"
  POSITION 3
  MAX-WIDTH 8
  ORDER 20

ADD FIELD "ccosto" OF "ac-copar" AS character 
  FORMAT "x(2)"
  INITIAL ""
  LABEL "Centro de costo"
  POSITION 4
  MAX-WIDTH 4
  ORDER 30

ADD FIELD "periodo" OF "ac-copar" AS integer 
  FORMAT "9999"
  INITIAL "0"
  LABEL "periodo"
  POSITION 5
  MAX-WIDTH 4
  ORDER 40

ADD FIELD "Correlativo" OF "ac-copar" AS integer 
  FORMAT "99999"
  INITIAL "0"
  LABEL "Correlativo"
  POSITION 6
  MAX-WIDTH 4
  COLUMN-LABEL "Correlativo"
  ORDER 50

ADD INDEX "Llave01" ON "ac-copar" 
  AREA "Miscelaneos"
  PRIMARY
  INDEX-FIELD "Codcia" ASCENDING 
  INDEX-FIELD "codcta" ASCENDING 
  INDEX-FIELD "ccosto" ASCENDING 
  INDEX-FIELD "periodo" ASCENDING 

ADD TABLE "ac-corre"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Correlativos"
  DUMP-NAME "ac-corre"

ADD FIELD "CodCia" OF "ac-corre" AS integer 
  DESCRIPTION "Código de Compañia"
  FORMAT "999"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  HELP "Código de compañia"
  ORDER 10

ADD FIELD "CodDiv" OF "ac-corre" AS character 
  FORMAT "XX-XXX"
  INITIAL "00000"
  LABEL "C.Div"
  POSITION 3
  MAX-WIDTH 12
  COLUMN-LABEL "C.Div"
  ORDER 20

ADD FIELD "NroSer" OF "ac-corre" AS integer 
  FORMAT "999"
  INITIAL "0"
  LABEL "Serie"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Serie"
  ORDER 50

ADD FIELD "Correlativo" OF "ac-corre" AS integer 
  FORMAT "999999"
  INITIAL "0"
  LABEL "Correlativo"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Correlativo"
  ORDER 60

ADD FIELD "Tipmov" OF "ac-corre" AS character 
  DESCRIPTION "Tipo de movimiento"
  FORMAT "X"
  INITIAL ""
  LABEL "Tipo de movimiento"
  POSITION 6
  MAX-WIDTH 2
  COLUMN-LABEL "Tp.!Movmto."
  HELP "Tipo de movimiento"
  ORDER 30

ADD FIELD "FlgEst" OF "ac-corre" AS logical 
  FORMAT "Activo/Inactivo"
  INITIAL "Activo"
  POSITION 7
  MAX-WIDTH 1
  ORDER 70

ADD INDEX "Llave01" ON "ac-corre" 
  AREA "Miscelaneos"
  UNIQUE
  PRIMARY
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "CodDiv" ASCENDING 
  INDEX-FIELD "Tipmov" ASCENDING 
  INDEX-FIELD "NroSer" ASCENDING 

ADD TABLE "ac-cpape"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
