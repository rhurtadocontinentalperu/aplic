ADD TABLE "oItems"
  AREA "Contabilidad"
  DESCRIPTION "08 - BPVS - I1 - Catalogo de articulos de inventario"
  DUMP-NAME "oitems"

ADD FIELD "RecordKey" OF "oItems" AS integer 
  DESCRIPTION "Correlativo"
  FORMAT ">>9"
  INITIAL "0"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "ItemCode" OF "oItems" AS character 
  DESCRIPTION "Codigo de Articulo"
  FORMAT "x(20)"
  INITIAL ""
  POSITION 3
  MAX-WIDTH 40
  ORDER 20

ADD FIELD "ItemName" OF "oItems" AS character 
  DESCRIPTION "Nombre del artículo"
  FORMAT "x(100)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 200
  ORDER 30

ADD FIELD "CostAccountingMethod" OF "oItems" AS character 
  DESCRIPTION "Método de costeo:
bis_MovingAverage : Método basado en el cálculo del coste medio del artículo en cada operación de compras y ventas. (Usar este valor)

bis_Standard : Sistema de determinación de precios que permite seleccionar un precio fijo que se utiliza después para todas las operaciones.

bis_FIFO : Sistema de inventario permanente donde el primer artículo adquirido también es el primero que se vende, con independencia del flujo de mercancías real."
  FORMAT "x(20)"
  INITIAL "bis_MovingAverage"
  POSITION 5
  MAX-WIDTH 40
  ORDER 40

ADD FIELD "DefaultWarehouse" OF "oItems" AS character 
  DESCRIPTION "Almacén por defecto"
  FORMAT "x(8)"
  INITIAL ""
  POSITION 6
  MAX-WIDTH 16
  ORDER 50

ADD FIELD "ForceSelectionOfSerialNumber" OF "oItems" AS character 
  DESCRIPTION "Selección forzosa de #Serie de Art.: tYES o tNO
"
  FORMAT "x(5)"
  INITIAL "tNO"
  POSITION 7
  MAX-WIDTH 6
  ORDER 60

ADD FIELD "Frozen" OF "oItems" AS character 
  DESCRIPTION "Artículo bloqueado?"
  FORMAT "x(5)"
  INITIAL "tNO"
  POSITION 8
  MAX-WIDTH 6
  ORDER 70

ADD FIELD "GLMethod" OF "oItems" AS character 
  DESCRIPTION "glm_WH : Todas las cuentas de mayor son definidas a nivel de almacenes. (usar este valor)

glm_ItemClass : Todas las cuentas de mayor son definidas a nivel de grupo de artículos.

glm_ItemLevel : Cualquier cuenta de mayor es definida a nivel de artículo."
  FORMAT "x(15)"
  INITIAL "glm_ItemClass"
  POSITION 9
  MAX-WIDTH 30
  ORDER 80

