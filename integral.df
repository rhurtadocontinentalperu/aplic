  LABEL "Promociones - Detalle"
  DUMP-NAME "vtadprom"
  TABLE-TRIGGER "REPLICATION-DELETE" NO-OVERRIDE PROCEDURE "APLIC\rpl\d-vtadprom.p" CRC "?" 
  TABLE-TRIGGER "REPLICATION-WRITE" NO-OVERRIDE PROCEDURE "APLIC\rpl\w-vtadprom.p" CRC "?" 

