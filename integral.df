ADD TABLE "rpl-wmigrv"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Replica RV SYPSA"
  DESCRIPTION "Tabla de replicaintermedia registro de ventas SYPSA de UTILEX a CONTINENTAL"
  DUMP-NAME "rpl-wmigrv"
  TABLE-TRIGGER "REPLICATION-WRITE" NO-OVERRIDE PROCEDURE "aplic\rpl\w-rpl-wmigrv.p" CRC "?" 

ADD FIELD "wcorre" OF "rpl-wmigrv" AS character 
  DESCRIPTION "Formato yyyymm0001"
  FORMAT "x(10)"
  INITIAL ""
  LABEL "correlativo carga"
  POSITION 2
  MAX-WIDTH 20
  ORDER 40

ADD FIELD "wsecue" OF "rpl-wmigrv" AS integer 
  FORMAT ">>>>9"
  INITIAL "0"
  LABEL "secuencia carga"
  POSITION 3
  MAX-WIDTH 4
  ORDER 50

ADD FIELD "wvejer" OF "rpl-wmigrv" AS integer 
  DESCRIPTION "Formato yyyy"
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "ejercicio"
  POSITION 4
  MAX-WIDTH 4
  ORDER 60

ADD FIELD "wvperi" OF "rpl-wmigrv" AS integer 
  DESCRIPTION "Formato mm"
  FORMAT "99"
  INITIAL "0"
  LABEL "periodo"
  POSITION 5
  MAX-WIDTH 4
  ORDER 70

ADD FIELD "wvtdoc" OF "rpl-wmigrv" AS character 
  DESCRIPTION "Ej. FC"
  FORMAT "x(2)"
  INITIAL ""
  LABEL "tipo documento"
  POSITION 6
  MAX-WIDTH 4
  ORDER 80

ADD FIELD "wvndoc" OF "rpl-wmigrv" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "número documento"
  POSITION 7
  MAX-WIDTH 30
  ORDER 90

ADD FIELD "wvfech" OF "rpl-wmigrv" AS integer 
  DESCRIPTION "Formato yyyymmdd"
  FORMAT ">>>>>>>9"
  INITIAL "0"
  LABEL "fecha documento"
  POSITION 8
  MAX-WIDTH 4
  ORDER 100

ADD FIELD "wvccli" OF "rpl-wmigrv" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "código cliente"
  POSITION 9
  MAX-WIDTH 20
  ORDER 110

ADD FIELD "wvclie" OF "rpl-wmigrv" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "nombre del cliente"
  POSITION 10
  MAX-WIDTH 80
  ORDER 120

ADD FIELD "wvcdir" OF "rpl-wmigrv" AS character 
  DESCRIPTION "Obligatorio si es un cliente nuevo"
  FORMAT "x(40)"
  INITIAL ""
  LABEL "dirección del cliente"
  POSITION 11
  MAX-WIDTH 80
  ORDER 130

ADD FIELD "wvcdis" OF "rpl-wmigrv" AS character 
  DESCRIPTION "Ej. MIRAFLORES"
  FORMAT "x(30)"
  INITIAL ""
  LABEL "distrito"
  POSITION 12
  MAX-WIDTH 60
  ORDER 140

ADD FIELD "wvref3" OF "rpl-wmigrv" AS character 
  DESCRIPTION "PJ: persona jurídica
NI: natural independiente
ND: natural dependiente, etc"
  FORMAT "x(2)"
  INITIAL ""
  LABEL "tipo cliente"
  POSITION 13
  MAX-WIDTH 4
  ORDER 150

ADD FIELD "wvtido" OF "rpl-wmigrv" AS character 
  DESCRIPTION "Ej. RU"
  FORMAT "x(2)"
  INITIAL ""
  LABEL "tipo de doc de indentidad"
  POSITION 14
  MAX-WIDTH 4
  ORDER 160

ADD FIELD "wvnudo" OF "rpl-wmigrv" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "número de doc identidad"
  POSITION 15
  MAX-WIDTH 30
  ORDER 170

ADD FIELD "wvref2" OF "rpl-wmigrv" AS character 
  FORMAT "x(2)"
  INITIAL "99"
  LABEL "relación comercial"
  POSITION 16
  MAX-WIDTH 4
  ORDER 180

ADD FIELD "wvmone" OF "rpl-wmigrv" AS integer 
  DESCRIPTION "00: soles
01: dólares"
  FORMAT "99"
  INITIAL "0"
  LABEL "moneda de origen"
  POSITION 17
  MAX-WIDTH 4
  ORDER 190

ADD FIELD "wvtcam" OF "rpl-wmigrv" AS decimal 
  FORMAT ">>>>>>>>>.999999"
  INITIAL "0"
  LABEL "tipo de cambio"
  POSITION 18
  MAX-WIDTH 21
  DECIMALS 6
  ORDER 200

ADD FIELD "wvvalv" OF "rpl-wmigrv" AS decimal 
  DESCRIPTION "Solo si es una venta afecta"
  FORMAT "9999999999999.99"
  INITIAL "0"
  LABEL "valor venta afecta"
  POSITION 19
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 210

ADD FIELD "wvcval" OF "rpl-wmigrv" AS character 
  DESCRIPTION "Múltiple de acuerdo al documento"
  FORMAT "x(15)"
  INITIAL ""
  LABEL "cuenta valor venta afecto"
  POSITION 20
  MAX-WIDTH 30
