  AREA "Ventas"
  UNIQUE
  PRIMARY
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "CodDiv" ASCENDING 
  INDEX-FIELD "CodDoc" ASCENDING 
  INDEX-FIELD "NroDoc" ASCENDING 

