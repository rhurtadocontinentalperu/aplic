  FORMAT "->>,>>9.99"
  INITIAL "0"
  LABEL "Empaque"
  POSITION 7
  MAX-WIDTH 17
  COLUMN-LABEL "Cantidad!Empaque"
  DECIMALS 2
  ORDER 70

ADD FIELD "Chr__01" OF "LogVtaListaMay" AS character 
  FORMAT "X(8)"
  INITIAL ""
  POSITION 8
  MAX-WIDTH 16
  ORDER 120

ADD FIELD "PreOfi" OF "LogVtaListaMay" AS decimal 
  DESCRIPTION "Precio Oficina"
  FORMAT ">,>>>,>>9.9999"
  INITIAL "0"
  LABEL "Precio Oficina"
  POSITION 9
  MAX-WIDTH 19
  COLUMN-LABEL "Precio Oficina"
  DECIMALS 4
  ORDER 130

