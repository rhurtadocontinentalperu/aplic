ADD TABLE "UserMod"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Modulos por Usuario"
  DESCRIPTION "Modulos que puede accesar el Usuario"
  DUMP-NAME "usermod"

ADD FIELD "Usuario" OF "UserMod" AS character 
  DESCRIPTION "Usuario del Sistema"
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Usuario"
  POSITION 2
  MAX-WIDTH 24
  COLUMN-LABEL "Usuario"
  HELP "Usuario del Sistema"
  ORDER 20

ADD FIELD "Modulo" OF "UserMod" AS character 
  DESCRIPTION "Codigo del Paquete a Ejecutar"
  FORMAT "x(3)"
  INITIAL ""
  LABEL "Modulo"
  POSITION 3
  MAX-WIDTH 6
  COLUMN-LABEL "Modulo"
  HELP "Codigo del Paquete a Ejecutar"
  ORDER 30

ADD FIELD "CodCia" OF "UserMod" AS integer 
  DESCRIPTION "Codigo de la Empresa "
  FORMAT "999"
  INITIAL "0"
  LABEL "Cia"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  VALEXP "CodCia > 0"
  VALMSG "Invalido Registro"
  HELP "Codigo de la Empresa"
  ORDER 10

ADD FIELD "admin" OF "UserMod" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Administrador"
  POSITION 5
  MAX-WIDTH 1
  COLUMN-LABEL "Administrador"
  HELP "Usuario Administrador del Sistema."
  ORDER 50

ADD FIELD "Grupo" OF "UserMod" AS character 
  FORMAT "X(8)"
  INITIAL ""
  LABEL "Grupos"
  POSITION 6
  MAX-WIDTH 16
  COLUMN-LABEL "Grupos"
  HELP "Accesos seg£n su categotia de usuario"
  ORDER 70

ADD INDEX "Umod01" ON "UserMod" 
  AREA "Miscelaneos"
  PRIMARY
  INDEX-FIELD "Usuario" ASCENDING 
  INDEX-FIELD "Modulo" ASCENDING 
  INDEX-FIELD "CodCia" ASCENDING 

