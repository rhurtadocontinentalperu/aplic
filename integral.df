  FORMAT "(Z,ZZZ,ZZ9.9999)"
  INITIAL "0"
  POSITION 7
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 170

ADD INDEX "llave01" ON "PR-LIQD2" 
  AREA "Miscelaneos"
  UNIQUE
  PRIMARY
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "Numliq" ASCENDING 
  INDEX-FIELD "codper" ASCENDING 

