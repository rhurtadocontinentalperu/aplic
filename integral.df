ADD FIELD "CodCia" OF "PriCDctoxImport" AS integer 
  FORMAT "999"
  INITIAL "0"
  LABEL "Codigo"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Codigo"
  HELP "Codigo de compania"
  ORDER 10

ADD FIELD "Id" OF "PriCDctoxImport" AS int64 
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  POSITION 3
  MAX-WIDTH 8
