  FORMAT "X(6)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 12
  ORDER 120

ADD FIELD "Horas" OF "PR-LIQD2" AS decimal 
  DESCRIPTION "Hora Fin"
  FORMAT "99.99"
  INITIAL "0"
