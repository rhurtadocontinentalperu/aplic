  FORMAT "Cerrada/Abierta"
  INITIAL "Abierta"
  LABEL "Condición"
  POSITION 8
  MAX-WIDTH 1
  COLUMN-LABEL "Condición"
  HELP "Cerrada/Abierta"
  ORDER 70

