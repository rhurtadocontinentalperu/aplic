ADD TABLE "FacTabla"
  AREA "Ventas"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Tablas Generales Facturacion"
  DUMP-NAME "factabla"
  TABLE-TRIGGER "REPLICATION-DELETE" NO-OVERRIDE PROCEDURE "aplic\Rpl\d-factabla.p" CRC "?" 
  TABLE-TRIGGER "REPLICATION-WRITE" NO-OVERRIDE PROCEDURE "aplic\Rpl\w-factabla.p" CRC "?" 

ADD FIELD "CodCia" OF "FacTabla" AS integer 
  FORMAT "999"
  INITIAL "0"
  LABEL "Codigo"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Codigo"
  HELP "Codigo de compania"
  ORDER 10

ADD FIELD "Tabla" OF "FacTabla" AS character 
  FORMAT "x(2)"
  INITIAL ""
  POSITION 3
  MAX-WIDTH 4
  ORDER 20

ADD FIELD "Codigo" OF "FacTabla" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Codigo"
  POSITION 4
  MAX-WIDTH 16
  COLUMN-LABEL "Codigo"
  HELP "C¢digo de auxiliar"
  ORDER 30

ADD FIELD "Nombre" OF "FacTabla" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Nombre"
  POSITION 5
  MAX-WIDTH 80
  COLUMN-LABEL "Nombre"
  HELP "Nombre de auxiliar"
  ORDER 40

ADD FIELD "Valor" OF "FacTabla" AS decimal 
  FORMAT "->>,>>9.9999"
  INITIAL "0"
  POSITION 6
  MAX-WIDTH 440
  EXTENT 20
  DECIMALS 4
  ORDER 50

ADD FIELD "Campo-C" OF "FacTabla" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 7
  MAX-WIDTH 360
  EXTENT 20
  ORDER 60

ADD FIELD "Campo-D" OF "FacTabla" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 8
  MAX-WIDTH 360
  EXTENT 20
  ORDER 70

ADD FIELD "Campo-L" OF "FacTabla" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 9
  MAX-WIDTH 160
  EXTENT 20
  ORDER 80

ADD INDEX "Llave01" ON "FacTabla" 
  AREA "Ventas"
  UNIQUE
  PRIMARY
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "Tabla" ASCENDING 
  INDEX-FIELD "Codigo" ASCENDING 

