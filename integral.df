  DESCRIPTION "Configuracion de Condiciones para la generacion pre-hruta, en tapiceros"
  DUMP-NAME "rut-conf-phr"

ADD FIELD "CodCia" OF "rut-conf-phr" AS integer 
  DESCRIPTION "Codigo de la Empresa "
  FORMAT "999"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  VALEXP "CodCia >= 0"
  VALMSG "Invalido Registro"
