  LABEL "Cabecera Comisiones"
  DESCRIPTION "Control de pago de comisiones"
  DUMP-NAME "facccomi"

ADD FIELD "CodCia" OF "FacCComi" AS integer 
  DESCRIPTION "Codigo de Compañia"
  FORMAT "999"
  INITIAL "0"
  LABEL "Cia."
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia."
  HELP "Codigo de Compañia"
  ORDER 10

