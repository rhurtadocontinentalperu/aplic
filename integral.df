  TABLE-TRIGGER "DELETE" NO-OVERRIDE PROCEDURE "aplic\Triggers\d-gn-prov.p" CRC "?" 
  TABLE-TRIGGER "REPLICATION-DELETE" NO-OVERRIDE PROCEDURE "APLIC\rpl\d-gn-prov.p" CRC "?" 
  TABLE-TRIGGER "REPLICATION-WRITE" NO-OVERRIDE PROCEDURE "APLIC\rpl\w-gn-prov.p" CRC "?" 
