ADD TABLE "EvtSemanas"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Configuracion de las semanas"
  DUMP-NAME "evtsemanas"

ADD FIELD "CodCia" OF "EvtSemanas" AS integer 
  FORMAT "999"
  INITIAL "0"
  LABEL "Compañia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cias"
  HELP "Código de Compañia"
  ORDER 10

ADD FIELD "Periodo" OF "EvtSemanas" AS integer 
  FORMAT "9999"
  INITIAL "0"
  LABEL "Año"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Año"
  HELP "Año Contable"
  ORDER 20

ADD FIELD "NroSem" OF "EvtSemanas" AS integer 
  FORMAT "99"
  INITIAL "0"
  LABEL "Semana"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Semana"
  VALEXP "NroSem > 0 AND NroSem < 54"
  VALMSG "Invalido Nro. de Semana"
  HELP "Nro. de Semana"
  ORDER 30

ADD FIELD "NroMes" OF "EvtSemanas" AS integer 
  FORMAT "99"
  INITIAL "0"
  LABEL "Mes"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Mes"
  VALEXP "NroMes > 0 AND NroMes < 13"
  VALMSG "Invalido Nro de Mes"
  HELP "Mes de la semana"
  ORDER 40

ADD FIELD "FecIni" OF "EvtSemanas" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Inicio"
  POSITION 6
  MAX-WIDTH 4
  COLUMN-LABEL "Inicio"
  HELP "Fecha de Inicio"
  ORDER 50

ADD FIELD "FecFin" OF "EvtSemanas" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Fin"
  POSITION 7
  MAX-WIDTH 4
  COLUMN-LABEL "Fin"
  HELP "Fecha de finalización"
  ORDER 60

ADD INDEX "Llave01" ON "EvtSemanas" 
  AREA "Miscelaneos"
  UNIQUE
  PRIMARY
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "Periodo" ASCENDING 
  INDEX-FIELD "NroSem" ASCENDING 

