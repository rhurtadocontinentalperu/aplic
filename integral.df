  FORMAT "x(5)"
  INITIAL ""
  LABEL "Division"
  POSITION 3
  MAX-WIDTH 10
  COLUMN-LABEL "Division"
  HELP "Ingrese el Codigo de Division"
  ORDER 20

ADD FIELD "codmat" OF "lcc_division" AS character 
  FORMAT "X(6)"
  INITIAL ""
  LABEL "Codigo Articulo"
  POSITION 4
  MAX-WIDTH 12
  COLUMN-LABEL "Codigo Articulo"
  ORDER 30

