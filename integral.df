ADD TABLE "fifommatg"
  AREA "Inventarios"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Articulos Series"
  DUMP-NAME "fifommatg"

ADD FIELD "CodCia" OF "fifommatg" AS integer 
  DESCRIPTION "Código de compañia"
  FORMAT "999"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  HELP "Código de compañia"
  ORDER 10

ADD FIELD "CodMat" OF "fifommatg" AS character 
  FORMAT "X(6)"
  INITIAL ""
  LABEL "Codigo Articulo"
  POSITION 3
  MAX-WIDTH 12
  COLUMN-LABEL "Codigo Articulo"
  ORDER 20

ADD FIELD "FchIng" OF "fifommatg" AS date 
  DESCRIPTION "Fecha de Ingreso"
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Fecha Ing."
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Fecha Ing."
  HELP "Fecha de Ingreso"
  ORDER 70

ADD FIELD "SerialNumber" OF "fifommatg" AS character 
  DESCRIPTION "Serie o Lote"
  FORMAT "x(60)"
  INITIAL ""
  POSITION 5
  MAX-WIDTH 120
  ORDER 30

ADD FIELD "AssetId" OF "fifommatg" AS character 
  FORMAT "x(50)"
  INITIAL ""
  POSITION 6
  MAX-WIDTH 100
  ORDER 40

ADD FIELD "ExpiryDate" OF "fifommatg" AS date 
  DESCRIPTION "Fecha de vencimiento"
  FORMAT "99/99/9999"
  INITIAL ?
  POSITION 7
  MAX-WIDTH 4
  ORDER 50

ADD FIELD "WarrantyDate" OF "fifommatg" AS date 
  DESCRIPTION "Fecha de garantía"
  FORMAT "99/99/9999"
  INITIAL ?
  POSITION 8
  MAX-WIDTH 4
  ORDER 60

ADD FIELD "UsrIng" OF "fifommatg" AS character 
  FORMAT "x(15)"
  INITIAL ""
  POSITION 9
  MAX-WIDTH 30
  ORDER 80

ADD INDEX "Idx00" ON "fifommatg" 
  AREA "Inventarios"
  UNIQUE
  PRIMARY
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "CodMat" ASCENDING 
  INDEX-FIELD "SerialNumber" ASCENDING 

