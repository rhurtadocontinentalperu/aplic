ADD TABLE "ImCCst"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  DUMP-NAME "imccst"

ADD FIELD "NroReq" OF "ImCCst" AS integer 
  FORMAT "999999"
  INITIAL "0"
  LABEL "NroReq"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "NroReq"
  ORDER 40

ADD FIELD "CodCia" OF "ImCCst" AS integer 
  DESCRIPTION "Código de compañia"
  FORMAT "999"
  INITIAL "0"
  LABEL "Cia"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  HELP "Código de compañia"
  ORDER 10
  MANDATORY

ADD FIELD "CodDiv" OF "ImCCst" AS character 
  FORMAT "x(5)"
  INITIAL "00000"
  LABEL "Division"
  POSITION 4
  MAX-WIDTH 10
  COLUMN-LABEL "Division"
  ORDER 20

ADD FIELD "ImpTotP" OF "ImCCst" AS decimal 
