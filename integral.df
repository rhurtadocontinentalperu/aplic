  AREA "Ventas"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Categoria por proveedor"
  DESCRIPTION "Categorias y descuentos por proveedor"
  DUMP-NAME "facctpro"

ADD FIELD "CodCia" OF "FacCtPro" AS integer 
  DESCRIPTION "Codigo de la Empresa "
  FORMAT "999"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  VALEXP "CodCia >= 0"
  VALMSG "Invalido Registro"
  HELP "Codigo de la Empresa"
  ORDER 10

ADD FIELD "CodPro" OF "FacCtPro" AS character 
  DESCRIPTION "Codigo del Proveedor"
  FORMAT "x(11)"
  INITIAL ""
  LABEL "Codigo"
  POSITION 3
  MAX-WIDTH 22
  COLUMN-LABEL "Codigo"
  HELP "C¢digo del Proveedor"
  ORDER 20

ADD FIELD "Categoria" OF "FacCtPro" AS character 
  DESCRIPTION "Del 1 al 4"
  FORMAT "x(1)"
  INITIAL ""
  LABEL "Categoria"
  POSITION 4
  MAX-WIDTH 2
  ORDER 30

ADD FIELD "Dsctos" OF "FacCtPro" AS decimal 
  DESCRIPTION "Por clasificacion del cliente, en grupos de a 4  de la A a la E"
  FORMAT ">>9.9999"
  INITIAL "0"
  POSITION 5
  MAX-WIDTH 720
  EXTENT 40
  DECIMALS 4
  ORDER 40

ADD INDEX "Llave01" ON "FacCtPro" 
  AREA "Ventas"
  UNIQUE
  PRIMARY
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "CodPro" ASCENDING 
  INDEX-FIELD "Categoria" ASCENDING 

