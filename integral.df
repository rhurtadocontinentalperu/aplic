  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Ubicaciones de articulo"
  DESCRIPTION "Ubicaciones de los articulos por almacen"
  DUMP-NAME "almubimat"

ADD FIELD "CodCia" OF "almubimat" AS integer 
  FORMAT ">>9"
  INITIAL "0"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "CodAlm" OF "almubimat" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 3
  MAX-WIDTH 16
  ORDER 20

ADD FIELD "CodMat" OF "almubimat" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 16
  ORDER 30

ADD FIELD "CodUbi" OF "almubimat" AS character 
  FORMAT "x(15)"
  INITIAL ""
  POSITION 5
  MAX-WIDTH 30
  ORDER 40

ADD FIELD "CodZona" OF "almubimat" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Codigo Zona"
  POSITION 6
  MAX-WIDTH 16
  ORDER 50

ADD INDEX "Idx00" ON "almubimat" 
  AREA "Inventarios"
  PRIMARY
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "CodAlm" ASCENDING 
  INDEX-FIELD "CodMat" ASCENDING 
  INDEX-FIELD "CodUbi" ASCENDING 

ADD INDEX "Idx01" ON "almubimat" 
  AREA "Inventarios"
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "CodMat" ASCENDING 
  INDEX-FIELD "CodAlm" ASCENDING 
  INDEX-FIELD "CodUbi" ASCENDING 

ADD INDEX "Idx02" ON "almubimat" 
  AREA "Inventarios"
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "CodAlm" ASCENDING 
  INDEX-FIELD "CodUbi" ASCENDING 
  INDEX-FIELD "CodMat" ASCENDING 

ADD TABLE "AlmUPInv"
  AREA "Inventarios"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Ubicaciones Preinventarios"
  DUMP-NAME "almupinv"

ADD FIELD "CodCia" OF "AlmUPInv" AS integer 
  DESCRIPTION "Código de Compañia"
  FORMAT "999"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  HELP "Código de Compañia"
  ORDER 10

ADD FIELD "CodAlm" OF "AlmUPInv" AS character 
  DESCRIPTION "Almacén"
  FORMAT "x(3)"
  INITIAL ""
  LABEL "Almacén"
  POSITION 3
  MAX-WIDTH 6
  COLUMN-LABEL "Almacén"
  HELP "Código de almacén"
  ORDER 20

ADD FIELD "CodUbi" OF "AlmUPInv" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 16
  ORDER 30

ADD FIELD "FchCrea" OF "AlmUPInv" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  POSITION 5
  MAX-WIDTH 4
  ORDER 40

ADD FIELD "FchMod" OF "AlmUPInv" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  POSITION 6
  MAX-WIDTH 4
  ORDER 50

ADD FIELD "SCerrado" OF "AlmUPInv" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 7
  MAX-WIDTH 1
  ORDER 60

ADD FIELD "PRID-Crea" OF "AlmUPInv" AS int64 
  FORMAT "999999999999999"
  INITIAL "0"
  POSITION 8
  MAX-WIDTH 8
  ORDER 70

ADD FIELD "PRID-Mod" OF "AlmUPInv" AS int64 
  FORMAT "999999999999999"
  INITIAL "0"
  POSITION 9
  MAX-WIDTH 8
  ORDER 80

ADD FIELD "Libre_c01" OF "AlmUPInv" AS character 
  FORMAT "x(50)"
  INITIAL ""
  POSITION 10
  MAX-WIDTH 2040
  EXTENT 20
  ORDER 90

ADD FIELD "Libre_d01" OF "AlmUPInv" AS decimal 
  FORMAT "->>>,>>>,>>9.9999"
  INITIAL "0"
  POSITION 11
  MAX-WIDTH 720
  EXTENT 20
  DECIMALS 4
  ORDER 100

ADD FIELD "Libre_f01" OF "AlmUPInv" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  POSITION 12
  MAX-WIDTH 440
  EXTENT 20
  ORDER 110

ADD INDEX "Idx00" ON "AlmUPInv" 
  AREA "Inventarios"
  PRIMARY
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "CodAlm" ASCENDING 
  INDEX-FIELD "CodUbi" ASCENDING 

ADD TABLE "AlmUsers"
  AREA "Inventarios"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Almacen por Usuarios"
  DUMP-NAME "almusers"

ADD FIELD "User-Id" OF "AlmUsers" AS character 
  FORMAT "X(11)"
  INITIAL ""
  LABEL "Usuario"
  POSITION 2
  MAX-WIDTH 22
  COLUMN-LABEL "Usuario"
  ORDER 20

ADD FIELD "CodCia" OF "AlmUsers" AS integer 
  FORMAT "999"
  INITIAL "0"
  LABEL "Compañia"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Cias"
  HELP "Código de Compañia"
  ORDER 10

ADD FIELD "CodAlm" OF "AlmUsers" AS character 
  DESCRIPTION "Almacén"
  FORMAT "x(3)"
  INITIAL ""
  LABEL "Almacén"
  POSITION 4
  MAX-WIDTH 6
  COLUMN-LABEL "Almacén"
  HELP "Código de almacén"
  ORDER 30

ADD INDEX "user01" ON "AlmUsers" 
  AREA "Inventarios"
  UNIQUE
  PRIMARY
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "User-Id" ASCENDING 
  INDEX-FIELD "CodAlm" ASCENDING 

ADD TABLE "AlmUsrMov"
  AREA "Inventarios"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Usuarios Movimientos"
  DESCRIPTION "Movimientos Validos por cada usuario"
  DUMP-NAME "almusrmov"

ADD FIELD "CodCia" OF "AlmUsrMov" AS integer 
  FORMAT "999"
  INITIAL "0"
  LABEL "Compañia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cias"
  HELP "Código de Compañia"
  ORDER 10

ADD FIELD "User-Id" OF "AlmUsrMov" AS character 
  FORMAT "X(11)"
  INITIAL ""
  LABEL "Usuario"
  POSITION 3
  MAX-WIDTH 22
  COLUMN-LABEL "Usuario"
  ORDER 20

ADD FIELD "Tipmov" OF "AlmUsrMov" AS character 
  DESCRIPTION "Tipo de movimiento"
  FORMAT "X"
  INITIAL ""
  LABEL "Tipo de movimiento"
  POSITION 4
  MAX-WIDTH 2
  COLUMN-LABEL "Tp.!Movmto."
  HELP "Tipo de movimiento"
  ORDER 30

ADD FIELD "Codmov" OF "AlmUsrMov" AS integer 
  DESCRIPTION "Código de movimiento"
  FORMAT "99"
  INITIAL "0"
  LABEL "Código de movimiento"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Cod!mov"
  HELP "Código de movimiento"
  ORDER 40

ADD FIELD "Fecha" OF "AlmUsrMov" AS datetime 
  FORMAT "99/99/9999 HH:MM:SS"
  INITIAL ?
  LABEL "Fecha Creacion"
  POSITION 6
  MAX-WIDTH 8
  ORDER 50

ADD FIELD "Usuario" OF "AlmUsrMov" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 7
  MAX-WIDTH 16
  ORDER 60

ADD INDEX "Llave01" ON "AlmUsrMov" 
  AREA "Inventarios"
  UNIQUE
  PRIMARY
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "User-Id" ASCENDING 
  INDEX-FIELD "Tipmov" ASCENDING 
  INDEX-FIELD "Codmov" ASCENDING 

