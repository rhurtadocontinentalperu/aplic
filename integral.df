ADD TABLE "Gn-AProv"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  DUMP-NAME "gn-aprov"

ADD FIELD "CodCia" OF "Gn-AProv" AS integer 
  DESCRIPTION "Codigo de la Empresa "
  FORMAT "999"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  VALEXP "CodCia >= 0"
  VALMSG "Invalido Registro"
  HELP "Codigo de la Empresa"
  ORDER 10

ADD FIELD "CodPro" OF "Gn-AProv" AS character 
  DESCRIPTION "Codigo del Proveedor"
  FORMAT "x(11)"
  INITIAL ""
  LABEL "Codigo"
  POSITION 3
  MAX-WIDTH 22
  COLUMN-LABEL "Codigo"
  HELP "C¢digo del Proveedor"
  ORDER 20

ADD FIELD "CodEan" OF "Gn-AProv" AS character 
  DESCRIPTION "Codigo EAN"
  FORMAT "x(35)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 70
  ORDER 30

ADD INDEX "Llaveo01" ON "Gn-AProv" 
  AREA "Miscelaneos"
  UNIQUE
  PRIMARY
  INDEX-FIELD "CodCia" ASCENDING 
  INDEX-FIELD "CodPro" ASCENDING 

ADD TABLE "gn-card"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Tarjeta Continetal"
  DUMP-NAME "gn-card"
  TABLE-TRIGGER "REPLICATION-DELETE" NO-OVERRIDE PROCEDURE "APLIC\rpl\d-gn-card.p" CRC "?" 
  TABLE-TRIGGER "REPLICATION-WRITE" NO-OVERRIDE PROCEDURE "APLIC\rpl\w-gn-card.p" CRC "?" 

ADD FIELD "NroCard" OF "gn-card" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "NroCard"
  POSITION 2
  MAX-WIDTH 16
  COLUMN-LABEL "Nrocard"
  ORDER 10

ADD FIELD "TipBon" OF "gn-card" AS integer 
  FORMAT "99"
  INITIAL "0"
  LABEL "TipBon"
  POSITION 3
  MAX-WIDTH 60
  COLUMN-LABEL "TipBon"
