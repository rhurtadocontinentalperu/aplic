ADD TABLE "LogVtaListaMay"
  AREA "Miscelaneos"
  CAN-CREATE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-DELETE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  CAN-READ "!,*"
  CAN-WRITE "!usrddigger,!rptbuilder,!usrtempo,!sololectura,*"
  LABEL "Log Lista Mayorista x Division"
  DUMP-NAME "logvtalistamay"

ADD FIELD "CodCia" OF "LogVtaListaMay" AS integer 
  DESCRIPTION "Código de compañia"
  FORMAT "999"
  INITIAL "0"
  LABEL "Cia"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Cia"
  HELP "Código de compañia"
  ORDER 10

ADD FIELD "CodDiv" OF "LogVtaListaMay" AS character 
  FORMAT "x(5)"
  INITIAL ""
  LABEL "Division"
  POSITION 3
  MAX-WIDTH 10
  COLUMN-LABEL "Division"
  HELP "Ingrese el Codigo de Division"
  ORDER 20

ADD FIELD "codmat" OF "LogVtaListaMay" AS character 
  FORMAT "X(6)"
  INITIAL ""
  LABEL "Codigo Articulo"
  POSITION 4
  MAX-WIDTH 12
  COLUMN-LABEL "Codigo Articulo"
  ORDER 30

ADD FIELD "MonVta" OF "LogVtaListaMay" AS integer 
  DESCRIPTION "Moneda de venta"
  FORMAT "9"
  INITIAL "0"
  LABEL "Moneda"
  POSITION 5
  MAX-WIDTH 4
  VIEW-AS "VIEW-AS RADIO-SET    RADIO-BUTTONS ""Soles"" , 1 , ""Dolares"" , 2    VERTICAL    "
  COLUMN-LABEL "Moneda!venta"
  HELP "Moneda de venta"
  ORDER 40

ADD FIELD "TpoCmb" OF "LogVtaListaMay" AS decimal 
  DESCRIPTION "Tipo de cambio"
  FORMAT "Z9.9999"
  INITIAL "0"
  LABEL "Tpo. Cambio"
  POSITION 6
  MAX-WIDTH 19
  COLUMN-LABEL "Tipo de!Cambio"
  DECIMALS 4
  ORDER 50

